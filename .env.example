# Copy this to .env and adjust as needed.
# .env is gitignored — never commit secrets.

# JWT — MUST be at least 256 bits (32 ASCII chars). All services must share this value.
JWT_SECRET=change-me-to-a-very-long-random-secret-key-at-least-256-bits-long-please

# Token lifetime in milliseconds (default: 1 hour)
JWT_EXPIRATION_MS=3600000

# Shared secret for service-to-service calls (booking-service → theatre-service).
# In production: rotate this and use a real secret-management system.
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me-in-production
